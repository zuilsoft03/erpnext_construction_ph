 "modified_by": "Administrator",
 "owner": "Administrator",
 "module": "Construction PH",
 "message": "<p>The BCF topic <b>{{ doc.title }}</b> is now <b>{{ doc.status }}</b>.</p>{% if doc.resolution %}<p>Resolution: {{ doc.resolution }}</p>{% endif %}<p><a href=\"{{ frappe.utils.get_url(doc) }}\">Open the topic</a></p>",
 "recipients": [
  {
   "receiver_by_document_field": "assigned_to"
  },
  {
   "receiver_by_document_field": "creation_author"
  }
 ],
 "send_system_notification": 1,
 "send_email_notification": 1
}
